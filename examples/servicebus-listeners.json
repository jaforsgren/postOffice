{
  "info": {
    "name": "Service Bus Listeners",
    "description": "PEEK requests for the postoffice-tap subscriptions of the local Service Bus emulator. Use with servicebus-emulator.env.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Taps",
      "description": "One PEEK per topic's postoffice-tap subscription. Press w on this folder to watch them all.",
      "item": [
        {
          "name": "claimdocumentation",
          "request": {
            "method": "PEEK",
            "header": [
              {
                "key": "Connection-String",
                "value": "{{sb_connection_string}}"
              },
              {
                "key": "Max-Messages",
                "value": "50"
              },
              {
                "key": "Display-Property",
                "value": "message-name"
              }
            ],
            "url": {
              "raw": "asb://{{sb_topic_claim}}/postoffice-tap"
            }
          },
          "description": "Peeks the postoffice-tap subscription without consuming its messages. ctrl+e peeks once; w watches it in the background (w on the Taps folder watches every topic) and W shows what arrives, labelled by its message-name property.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('peeked', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "payments",
          "request": {
            "method": "PEEK",
            "header": [
              {
                "key": "Connection-String",
                "value": "{{sb_connection_string}}"
              },
              {
                "key": "Max-Messages",
                "value": "50"
              },
              {
                "key": "Display-Property",
                "value": "message-name"
              }
            ],
            "url": {
              "raw": "asb://{{sb_topic_payments}}/postoffice-tap"
            }
          },
          "description": "Peeks the postoffice-tap subscription without consuming its messages. ctrl+e peeks once; w watches it in the background (w on the Taps folder watches every topic) and W shows what arrives, labelled by its message-name property.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('peeked', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "conversation",
          "request": {
            "method": "PEEK",
            "header": [
              {
                "key": "Connection-String",
                "value": "{{sb_connection_string}}"
              },
              {
                "key": "Max-Messages",
                "value": "50"
              },
              {
                "key": "Display-Property",
                "value": "message-name"
              }
            ],
            "url": {
              "raw": "asb://{{sb_topic_conversation}}/postoffice-tap"
            }
          },
          "description": "Peeks the postoffice-tap subscription without consuming its messages. ctrl+e peeks once; w watches it in the background (w on the Taps folder watches every topic) and W shows what arrives, labelled by its message-name property.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('peeked', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "payments dead-letter",
      "request": {
        "method": "PEEK",
        "header": [
          {
            "key": "Connection-String",
            "value": "{{sb_connection_string}}"
          },
          {
            "key": "Dead-Letter",
            "value": "true"
          },
          {
            "key": "Display-Property",
            "value": "message-name"
          }
        ],
        "url": {
          "raw": "asb://{{sb_topic_payments}}/payments-sejfa-internal-subscription"
        }
      },
      "description": "Peeks the dead-letter queue of the sejfa-internal payments subscription."
    }
  ]
}
