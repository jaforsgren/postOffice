    {
      "name": "payments dead-letter",
      "request": {
        "method": "PEEK",
        "header": [
          {
            "key": "Connection-String",
            "value": "{{sb_connection_string}}"
          },
          {
            "key": "Dead-Letter",
            "value": "true"
          }
        ],
        "url": {
          "raw": "asb://{{sb_topic_payments}}/payments-sejfa-internal-subscription"
        }
      },
      "description": "Peeks the dead-letter queue of the sejfa-internal payments subscription."
    }
  ]
