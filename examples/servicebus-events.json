    {
      "name": "Cosmos",
      "item": [
        {
          "name": "Query Events By Id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{cosmos_auth}}"
              },
              {
                "key": "x-ms-date",
                "value": "{{cosmos_date}}"
              },
              {
                "key": "x-ms-version",
                "value": "2018-12-31"
              },
              {
                "key": "Content-Type",
                "value": "application/query+json"
              },
              {
                "key": "x-ms-documentdb-isquery",
                "value": "true"
              },
              {
                "key": "x-ms-max-item-count",
                "value": "-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"SELECT * FROM c WHERE c.id = @id\",\"parameters\":[{\"name\":\"@id\",\"value\":\"{{cosmos_query_id}}\"}]}"
            },
            "url": {
              "raw": "{{cosmos_url}}/dbs/{{cosmos_db}}/colls/{{cosmos_collection}}/docs"
            }
          },
          "description": "Queries the events collection for a document with id == {{cosmos_query_id}}. Set cosmos_query_id before executing.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var masterKey = pm.environment.get('cosmos_master_key');",
                  "var db        = pm.environment.get('cosmos_db');",
                  "var coll      = pm.environment.get('cosmos_collection');",
                  "var date      = new Date().toUTCString();",
                  "",
                  "var verb         = 'post';",
                  "var resourceType = 'docs';",
                  "var resourceLink = 'dbs/' + db + '/colls/' + coll;",
                  "var text = verb + '\\n' + resourceType + '\\n' + resourceLink + '\\n' + date.toLowerCase() + '\\n\\n';",
                  "",
                  "var keyBytes = CryptoJS.enc.Base64.parse(masterKey);",
                  "var hash     = CryptoJS.HmacSHA256(CryptoJS.enc.Utf8.parse(text), keyBytes);",
                  "var sig      = CryptoJS.enc.Base64.stringify(hash);",
                  "var token    = encodeURIComponent('type=master\u0026ver=1.0\u0026sig=' + sig);",
                  "",
                  "pm.collectionVariables.set('cosmos_auth', token);",
                  "pm.collectionVariables.set('cosmos_date', date);"
                ]
              }
            }
          ]
        },
